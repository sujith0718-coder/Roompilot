# Server & Application Runtime
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
TIMEZONE=Asia/Kolkata

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://your_db_user:your_db_password@your_cluster_address:27017/roomwise?ssl=true&authSource=admin

# Security & Authentication
JWT_SECRET=your_jwt_secret_min_32_chars_long_placeholder
JWT_EXPIRES_IN=1d

# Optional External API Integrations
GEMINI_API_KEY=your_optional_gemini_api_key_here
ALLOW_DESTRUCTIVE_SEED=false
